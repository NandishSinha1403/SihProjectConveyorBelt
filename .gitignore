__pycache__/
*.py[cod]
.venv/
venv/
.env
node_modules/
dist/
backend/media/uploads/*
backend/media/snapshots/*
!backend/media/**/.gitkeep
backend/models/*.pt
# The published model is an exception: it is the deliverable, and having it in
# the repo means a fresh clone can run detection without a training round.
!backend/models/belt_v1.pt
backend/data/*.db
backend/data/*.db-wal
backend/data/*.db-shm
# Note the trailing /*: git cannot re-include anything under a directory that
# is itself excluded, so this must exclude the children rather than the folder.
training/data/*
# The labelled rig dataset is the exception: it is hand-made, not downloadable,
# and kaggle_rig.ipynb reads it straight from the clone rather than fetching it
# from a hosted service. ~34 MB.
!training/data/rig_dataset/
training/runs/
.DS_Store
.run/

# Base weights are downloaded on demand, not vendored
yolo11*.pt
yolov8*.pt
