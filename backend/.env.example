# --- Video source -----------------------------------------------------------
# file://media/uploads/test1.mp4   uploaded test video (paced like a live camera)
# device://0                       laptop webcam / USB industrial camera
# rtsp://user:pass@10.0.0.5:554/s1 IP / PoE camera on site
# http://10.0.0.6/mjpg/video.mjpg  MJPEG-over-HTTP camera
SOURCE_URI=

# --- Detector ---------------------------------------------------------------
DETECTOR=mock                 # mock | yolo
# belt_v1.pt is trained on public industrial belt imagery; belt_v2.pt is
# fine-tuned on this project's own rig. They are not interchangeable -- each
# does poorly on the other's domain. Switch here rather than retraining.
MODEL_PATH=models/belt_v1.pt
DEVICE=auto                   # auto | mps | cuda | cpu
CONF_THRESHOLD=0.35
IOU_THRESHOLD=0.45
IMG_SIZE=640

# --- Pipeline ---------------------------------------------------------------
# Off by default: the model is trained without CLAHE, so enabling it here
# serves the detector a distribution it never saw. Measured cost: 58
# detections over 150 frames off vs 7 on. Turn on only if you retrain with it.
ENABLE_CLAHE=false
CONFIRM_FRAMES=5              # frames a track must survive before opening an incident
MAX_STREAM_FPS=30             # cap on MJPEG output rate; 30 matches a standard
                              # camera. At 20 the browser saw 19 fps while the
                              # pipeline ran at 30.
LOOP_FILE_SOURCES=true

# --- Persistence (Supabase) -------------------------------------------------
# Incident history lives in Postgres and snapshot JPEGs in a private Storage
# bucket, because a hosted API has no persistent disk: on Render's free tier
# both would be wiped by every redeploy and every spin-down.
#
# Take the connection string from Supabase -> Project Settings -> Database ->
# Connection pooling, the *transaction* pooler on port 6543. The direct host on
# 5432 is IPv6-only and Render's free tier cannot reach it.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
SUPABASE_URL=https://<ref>.supabase.co
# Service role key -- full access, bypasses row-level security. Backend only:
# never commit it and never expose it to the frontend.
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=snapshots

# --- Server -----------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
