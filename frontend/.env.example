# Where the API lives.
#
# Leave empty for local development: every path stays relative and Vite's proxy
# forwards /api and /ws to the backend on :8000.
#
# Set it when the frontend and backend are on different origins — a Vercel
# deployment talking to a Render backend. No trailing slash. The WebSocket URL
# is derived from it, so https:// becomes wss:// automatically.
#
# VITE_API_BASE=https://belt-sentinel-api.onrender.com
VITE_API_BASE=

# Live rig telemetry — the Supabase project the ESP32 belt-monitor node posts
# its vibration/LDR readings to. This is a DIFFERENT project from the incident
# history the backend writes to, so this is not the backend's SUPABASE_URL.
#
# Two tabs read it, not one: the 3D Model tab for live motion, and the Analytics
# tab, which replays the node's history to corroborate camera-found ruptures
# against the optical sensor. Leave these empty and both still render — the 3D
# Model reads OFFLINE forever, and Analytics reports "no sensor data", which is
# deliberately a different finding from 0% corroboration.
#
# Use the anon/publishable key. Never the service key: anything prefixed VITE_
# is compiled into the bundle and readable by every visitor.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
